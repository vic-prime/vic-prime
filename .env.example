```
NEXT_PUBLIC_API_BASE_URL=https://vic-prime.fonvicnuelfondom.workers.dev

# Flutterwave public key can be exposed to the browser if prefixed with NEXT_PUBLIC.
# In this foundation the client will use NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Server-side secrets — NEVER expose these to the browser.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
```
